# --- 1. BACKEND & SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production
BEEPTOR_URL=https://jhalak-test-api-99.free.beeceptor.com

# --- 2. SECURE EMAIL GATEWAY (GMAIL) ---
# Note: Keep credentials isolated to server-side only. Never expose to frontend.
GMAIL_USER=your-secure-email@gmail.com
GMAIL_PASS=your-app-specific-password

# --- 3. DATABASE & ENCRYPTION SECRETS ---
# SQLite3 local database configuration for Express backend
DB_PATH=./database.sqlite
JWT_SECRET=secure_enterprise_random_cryptographic_key_here

# --- 4. FRONTEND ENVIRONMENT MAPPING ---
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=production
REACT_APP_OFFLINE_MODE=true
